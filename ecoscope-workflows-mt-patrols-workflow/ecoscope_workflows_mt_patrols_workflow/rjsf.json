{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "er_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Data Source"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "Report Scope": {
      "type": "object",
      "description": "Choose which areas the report covers.",
      "ecoscope:task_group": true,
      "properties": {
        "report_scope": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": " ",
              "type": "string",
              "enum": [
                "Mara Triangle & Reserve",
                "Mara Triangle only",
                "Reserve only"
              ],
              "default": "Mara Triangle & Reserve"
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": "Report Scope"
        },
        "triangle_patrol_types": {
          "additionalProperties": false,
          "properties": {
            "vars": {
              "items": {
                "type": "string"
              },
              "title": " ",
              "type": "array",
              "ecoscope:advanced": true,
              "default": [
                "rhino_monitoring_patrol",
                "rhino_monitoring_vehicle_patrol",
                "general_law_enforcement",
                "law_enforcement_vehicle",
                "anti_harass_patrol",
                "anti_harass_vehicle",
                "community_outreach",
                "community_outreach_vehicle",
                "k9_deploy",
                "k9_training",
                "rabies_vaccine",
                "rabies_vaccine_vehicle"
              ]
            }
          },
          "required": [
            "vars"
          ],
          "type": "object",
          "title": "Mara Triangle Patrol Types",
          "ecoscope:advanced": true
        },
        "reserve_patrol_types": {
          "additionalProperties": false,
          "properties": {
            "vars": {
              "items": {
                "type": "string"
              },
              "title": " ",
              "type": "array",
              "ecoscope:advanced": true,
              "default": [
                "rhino_monitor_patrol_reserve",
                "rhino_monitoring_veh_patrol_reserve",
                "law_enforcement_reserve",
                "law_enforcement_veh_reserve",
                "anti_harass_reserve",
                "anti_harass_veh_reserve"
              ]
            }
          },
          "required": [
            "vars"
          ],
          "type": "object",
          "title": "Reserve Patrol Types",
          "ecoscope:advanced": true
        }
      }
    },
    "Process Patrol Observations": {
      "type": "object",
      "description": "Filter observations, build trajectories, join patrol attributes, and derive the patrol area.",
      "ecoscope:task_group": true,
      "properties": {
        "patrol_traj": {
          "additionalProperties": false,
          "properties": {
            "trajectory_segment_filter": {
              "allOf": [
                {
                  "$ref": "#/$defs/TrajectorySegmentFilter"
                }
              ],
              "default": {
                "min_length_meters": 0.001,
                "max_length_meters": 10000,
                "min_time_secs": 1,
                "max_time_secs": 172800,
                "min_speed_kmhr": 0.01,
                "max_speed_kmhr": 500
              },
              "title": " ",
              "description": "Filter track data by setting limits on track segment length, duration, and speed. Segments outside these bounds are removed, reducing noise and to focus on meaningful movement patterns.",
              "ecoscope:advanced": true
            }
          },
          "required": [],
          "type": "object",
          "title": "Trajectory Segment Filter"
        }
      }
    },
    "persist_patrol_traj": {
      "additionalProperties": false,
      "properties": {
        "filetypes": {
          "default": [
            "parquet"
          ],
          "items": {
            "enum": [
              "csv",
              "parquet"
            ],
            "type": "string"
          },
          "title": "Filetypes",
          "type": "array",
          "description": "The output format",
          "uniqueItems": true
        }
      },
      "required": [],
      "type": "object",
      "title": "Persist Patrol Trajectories"
    },
    "Generate Maps": {
      "type": "object",
      "description": "Trajectory maps per patrol area and mandate, colored by team.",
      "ecoscope:task_group": true,
      "properties": {
        "base_map_defs": {
          "additionalProperties": false,
          "properties": {
            "base_maps": {
              "default": [
                {
                  "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                  "opacity": 1
                }
              ],
              "items": {
                "title": "Base Layer",
                "anyOf": [
                  {
                    "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                    "properties": {
                      "url": {
                        "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                        "title": "Preset Layer URL",
                        "type": "string",
                        "const": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                        "enum": [
                          "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                        ]
                      },
                      "opacity": {
                        "default": 1,
                        "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                        "ecoscope:advanced": true,
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Layer Opacity",
                        "type": "number"
                      }
                    },
                    "title": "Open Street Map",
                    "type": "object"
                  },
                  {
                    "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                    "properties": {
                      "url": {
                        "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                        "title": "Preset Layer URL",
                        "type": "string",
                        "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                        "enum": [
                          "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
                        ]
                      },
                      "opacity": {
                        "default": 1,
                        "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                        "ecoscope:advanced": true,
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Layer Opacity",
                        "type": "number"
                      }
                    },
                    "title": "Roadmap",
                    "type": "object"
                  },
                  {
                    "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                    "properties": {
                      "url": {
                        "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                        "title": "Preset Layer URL",
                        "type": "string",
                        "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                        "enum": [
                          "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
                        ]
                      },
                      "opacity": {
                        "default": 1,
                        "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                        "ecoscope:advanced": true,
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Layer Opacity",
                        "type": "number"
                      }
                    },
                    "title": "Satellite",
                    "type": "object"
                  },
                  {
                    "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                    "properties": {
                      "url": {
                        "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                        "title": "Preset Layer URL",
                        "type": "string",
                        "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                        "enum": [
                          "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}"
                        ]
                      },
                      "opacity": {
                        "default": 1,
                        "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                        "ecoscope:advanced": true,
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Layer Opacity",
                        "type": "number"
                      }
                    },
                    "title": "Terrain",
                    "type": "object"
                  },
                  {
                    "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                    "properties": {
                      "url": {
                        "default": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                        "title": "Preset Layer URL",
                        "type": "string",
                        "const": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                        "enum": [
                          "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}"
                        ]
                      },
                      "opacity": {
                        "default": 1,
                        "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                        "ecoscope:advanced": true,
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Layer Opacity",
                        "type": "number"
                      }
                    },
                    "title": "USGS Hillshade",
                    "type": "object"
                  },
                  {
                    "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                    "properties": {
                      "url": {
                        "default": "https://example.tiles.com/{z}/{x}/{y}.png",
                        "description": "The URL of a publicly accessible tiled raster service.",
                        "pattern": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}([-a-zA-Z0-9()@:%_\\+.~#?&//=\\{\\}]*)",
                        "title": "Custom Layer URL",
                        "type": "string"
                      },
                      "opacity": {
                        "default": 1,
                        "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                        "ecoscope:advanced": true,
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Custom Layer Opacity",
                        "type": "number"
                      },
                      "max_zoom": {
                        "default": 20,
                        "description": "Set the maximum zoom level to fetch tiles for.",
                        "title": "Custom Layer Max Zoom",
                        "type": "integer"
                      },
                      "min_zoom": {
                        "default": 0,
                        "description": "Set the minimum zoom level to fetch tiles for.",
                        "title": "Custom Layer Min Zoom",
                        "type": "integer"
                      }
                    },
                    "title": "Custom Layer (Advanced)",
                    "type": "object"
                  }
                ]
              },
              "title": " ",
              "type": "array",
              "description": "Select tile layers to use as base layers in map outputs. The first layer in the list will be the bottommost layer displayed.",
              "ecoscope:advanced": true
            }
          },
          "type": "object",
          "required": [],
          "title": "Base Maps"
        }
      }
    },
    "create_patrol_report": {
      "additionalProperties": false,
      "properties": {
        "template_path": {
          "title": "Template Path",
          "type": "string",
          "description": "Path or URL to the Word template (.docx) file with Jinja2 placeholders. Supports local paths and remote URLs (http://, https://).",
          "default": "https://raw.githubusercontent.com/wildlife-dynamics/mt-patrols/main/resources/templates/mt_patrols_report_template.docx"
        },
        "skip": {
          "default": false,
          "title": "Skip",
          "type": "boolean",
          "description": "Skip report generation entirely when True.",
          "ecoscope:advanced": true
        }
      },
      "required": [
        "template_path"
      ],
      "type": "object",
      "title": "Create Patrol Report"
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "TrajectorySegmentFilter": {
      "properties": {
        "min_length_meters": {
          "default": 0.001,
          "ecoscope:advanced": true,
          "minimum": 0.001,
          "title": "Minimum Segment Length (Meters)",
          "type": "number"
        },
        "max_length_meters": {
          "default": 100000,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Maximum Segment Length (Meters)",
          "type": "number"
        },
        "min_time_secs": {
          "default": 1,
          "ecoscope:advanced": true,
          "minimum": 1,
          "title": "Minimum Segment Duration (Seconds)",
          "type": "number"
        },
        "max_time_secs": {
          "default": 172800,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 1,
          "title": "Maximum Segment Duration (Seconds)",
          "type": "number"
        },
        "min_speed_kmhr": {
          "default": 0.01,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Minimum Segment Speed (Kilometers per Hour)",
          "type": "number"
        },
        "max_speed_kmhr": {
          "default": 500,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Maximum Segment Speed (Kilometers per Hour)",
          "type": "number"
        }
      },
      "title": "TrajectorySegmentFilter",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "Report Scope": {
      "ui:order": [
        "report_scope",
        "triangle_patrol_types",
        "reserve_patrol_types"
      ],
      "report_scope": {
        "var": {
          "ui:options": {
            "label": false
          }
        }
      },
      "triangle_patrol_types": {
        "vars": {
          "items": {
            "ui:options": {
              "label": false
            }
          }
        }
      },
      "reserve_patrol_types": {
        "vars": {
          "items": {
            "ui:options": {
              "label": false
            }
          }
        }
      }
    },
    "create_patrol_report": {
      "ui:order": [
        "template_path",
        "skip"
      ]
    },
    "ui:order": [
      "workflow_details",
      "er_client_name",
      "time_range",
      "Report Scope",
      "Process Patrol Observations",
      "persist_patrol_traj",
      "Generate Maps",
      "create_patrol_report"
    ]
  },
  "additionalProperties": false
}
