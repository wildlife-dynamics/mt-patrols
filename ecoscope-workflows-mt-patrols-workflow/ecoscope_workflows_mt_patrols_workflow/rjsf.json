{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "Report Scope": {
      "type": "object",
      "description": "Choose which areas the report covers.",
      "ecoscope:task_group": true,
      "properties": {
        "report_scope": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "",
              "type": "string",
              "enum": [
                "Mara Triangle & Reserve",
                "Mara Triangle only",
                "Reserve only"
              ],
              "default": "Mara Triangle & Reserve"
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": "Report Scope"
        },
        "triangle_patrol_types": {
          "additionalProperties": false,
          "properties": {
            "vars": {
              "items": {
                "type": "string"
              },
              "title": "",
              "type": "array",
              "default": [
                "rhino_monitoring_patrol",
                "rhino_monitoring_vehicle_patrol",
                "general_law_enforcement",
                "law_enforcement_vehicle",
                "anti_harass_patrol",
                "anti_harass_vehicle",
                "community_outreach",
                "community_outreach_vehicle",
                "k9_deploy",
                "k9_training",
                "rabies_vaccine",
                "rabies_vaccine_vehicle"
              ]
            }
          },
          "required": [
            "vars"
          ],
          "type": "object",
          "title": "Mara Triangle Patrol Types"
        },
        "reserve_patrol_types": {
          "additionalProperties": false,
          "properties": {
            "vars": {
              "items": {
                "type": "string"
              },
              "title": "",
              "type": "array",
              "default": [
                "rhino_monitor_patrol_reserve",
                "rhino_monitoring_veh_patrol_reserve",
                "law_enforcement_reserve",
                "law_enforcement_veh_reserve",
                "anti_harass_reserve",
                "anti_harass_veh_reserve"
              ]
            }
          },
          "required": [
            "vars"
          ],
          "type": "object",
          "title": "Reserve Patrol Types"
        }
      }
    },
    "patrol_obs": {
      "additionalProperties": false,
      "properties": {
        "file_path": {
          "title": "File Path",
          "type": "string",
          "description": "Path to the file to load. Supported formats: .parquet, .geoparquet, .geojson, .json, .gpkg, .csv, .shp"
        },
        "layer": {
          "default": null,
          "title": "Layer",
          "type": "string",
          "description": "Layer name for GeoPackage files (optional, only used for .gpkg files)",
          "ecoscope:advanced": true
        }
      },
      "required": [
        "file_path"
      ],
      "type": "object",
      "title": "Load Patrol Observations"
    },
    "patrol_info_events": {
      "additionalProperties": false,
      "properties": {
        "file_path": {
          "title": "File Path",
          "type": "string",
          "description": "Path to the file to load. Supported formats: .parquet, .geoparquet, .geojson, .json, .gpkg, .csv, .shp"
        },
        "layer": {
          "default": null,
          "title": "Layer",
          "type": "string",
          "description": "Layer name for GeoPackage files (optional, only used for .gpkg files)",
          "ecoscope:advanced": true
        }
      },
      "required": [
        "file_path"
      ],
      "type": "object",
      "title": "Load Patrol Info Events"
    },
    "Patrol Attributes": {
      "type": "object",
      "description": "Extract ranger, mandate, team, and transport attributes from patrol_information events.",
      "ecoscope:task_group": true,
      "properties": {
        "patrol_attributes": {
          "additionalProperties": false,
          "properties": {
            "columns": {
              "default": null,
              "items": {
                "type": "string"
              },
              "title": "Columns",
              "type": "array",
              "description": "Optional list of column names to include in the SQL query context. If specified, only these columns will be available in the 'df' table for querying. Use this to exclude columns with unsupported data types (list, dict) that cannot be stored in SQLite. If not specified, all columns are included.",
              "ecoscope:advanced": true
            },
            "sanitize": {
              "default": true,
              "title": "Sanitize",
              "type": "boolean",
              "description": "Whether to sanitize the DataFrame for Arrow/SQLite compatibility before querying. When True (default), complex columns (list, dict, set, bytes) are converted to JSON strings so pandasql/SQLite accepts them, removing the need for the 'columns' whitelist. Geometry columns are preserved. Set to False to pass columns through untouched.",
              "ecoscope:advanced": true
            }
          },
          "required": [],
          "type": "object",
          "title": "Deduplicate Patrol Attributes"
        }
      }
    },
    "Process Patrol Observations": {
      "type": "object",
      "description": "Filter observations, build trajectories, join patrol attributes, and derive the patrol area.",
      "ecoscope:task_group": true,
      "properties": {
        "patrol_traj": {
          "additionalProperties": false,
          "properties": {
            "trajectory_segment_filter": {
              "allOf": [
                {
                  "$ref": "#/$defs/TrajectorySegmentFilter"
                }
              ],
              "default": {
                "min_length_meters": 0.001,
                "max_length_meters": 10000,
                "min_time_secs": 1,
                "max_time_secs": 172800,
                "min_speed_kmhr": 0.01,
                "max_speed_kmhr": 500
              },
              "title": " ",
              "description": "Filter track data by setting limits on track segment length, duration, and speed. Segments outside these bounds are removed, reducing noise and to focus on meaningful movement patterns.",
              "ecoscope:advanced": true
            }
          },
          "required": [],
          "type": "object",
          "title": "Trajectory Segment Filter"
        },
        "traj_with_attributes": {
          "additionalProperties": false,
          "properties": {
            "left_on": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Left On",
              "description": "Column or index level names to join on in the left DataFrame."
            },
            "right_on": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Right On",
              "description": "Column or index level names to join on in the right DataFrame."
            },
            "left_index": {
              "default": false,
              "title": "Left Index",
              "type": "boolean",
              "description": "Use the index from the left DataFrame as the join key(s)."
            },
            "right_index": {
              "default": false,
              "title": "Right Index",
              "type": "boolean",
              "description": "Use the index from the right DataFrame as the join key(s)."
            }
          },
          "required": [],
          "type": "object",
          "title": "Join Patrol Attributes"
        }
      }
    },
    "persist_patrol_traj": {
      "additionalProperties": false,
      "properties": {
        "filetypes": {
          "default": [
            "parquet"
          ],
          "items": {
            "enum": [
              "csv",
              "parquet"
            ],
            "type": "string"
          },
          "title": "Filetypes",
          "type": "array",
          "description": "The output format",
          "uniqueItems": true
        }
      },
      "required": [],
      "type": "object",
      "title": "Persist Patrol Trajectories"
    }
  },
  "$defs": {
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "TrajectorySegmentFilter": {
      "properties": {
        "min_length_meters": {
          "default": 0.001,
          "ecoscope:advanced": true,
          "minimum": 0.001,
          "title": "Minimum Segment Length (Meters)",
          "type": "number"
        },
        "max_length_meters": {
          "default": 100000,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Maximum Segment Length (Meters)",
          "type": "number"
        },
        "min_time_secs": {
          "default": 1,
          "ecoscope:advanced": true,
          "minimum": 1,
          "title": "Minimum Segment Duration (Seconds)",
          "type": "number"
        },
        "max_time_secs": {
          "default": 172800,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 1,
          "title": "Maximum Segment Duration (Seconds)",
          "type": "number"
        },
        "min_speed_kmhr": {
          "default": 0.01,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Minimum Segment Speed (Kilometers per Hour)",
          "type": "number"
        },
        "max_speed_kmhr": {
          "default": 500,
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0.001,
          "title": "Maximum Segment Speed (Kilometers per Hour)",
          "type": "number"
        }
      },
      "title": "TrajectorySegmentFilter",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "Report Scope": {
      "ui:order": [
        "report_scope",
        "triangle_patrol_types",
        "reserve_patrol_types"
      ]
    },
    "patrol_obs": {
      "ui:order": [
        "file_path",
        "layer"
      ]
    },
    "patrol_info_events": {
      "ui:order": [
        "file_path",
        "layer"
      ]
    },
    "Patrol Attributes": {
      "patrol_attributes": {
        "ui:order": [
          "columns",
          "sanitize"
        ]
      }
    },
    "Process Patrol Observations": {
      "ui:order": [
        "patrol_traj",
        "traj_with_attributes"
      ],
      "traj_with_attributes": {
        "ui:order": [
          "left_on",
          "right_on",
          "left_index",
          "right_index"
        ]
      },
      "filter_patrol_obs": {
        "filter_point_coords": {
          "items": {
            "ui:options": {
              "label": false
            }
          }
        }
      }
    },
    "ui:order": [
      "workflow_details",
      "time_range",
      "Report Scope",
      "patrol_obs",
      "patrol_info_events",
      "Patrol Attributes",
      "Process Patrol Observations",
      "persist_patrol_traj"
    ]
  },
  "additionalProperties": false
}
